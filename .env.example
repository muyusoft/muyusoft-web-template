# Copy this file to .env.local (ignored by git) and adjust the values.

# Server-only: never prefix these with NEXT_PUBLIC_.
# Backend base URL, without /api/v1 (the client adds it).
#   dev:   https://api.dev.muyusoft.com
#   local: http://localhost:8080
API_URL=https://api.dev.muyusoft.com
# Milliseconds. The backend cuts requests at 15 s.
API_TIMEOUT=15000

# Public: inlined into the browser bundle. development | preview | production
# Only "production" lets search engines index the site.
NEXT_PUBLIC_ENVIRONMENT=development
# Canonical public URL (sitemap, robots, social previews). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
